APP_NAME=رشن
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reshen
DB_USERNAME=root
DB_PASSWORD=

# روی هاست اشتراکی: database — روی VPS: redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── پیامک ──────────────────────────────────────────────
# بدون افزونهٔ php-soap، ملی‌پیامک اصلاً کار نمی‌کند.
# پیش از هر چیز: php artisan reshen:doctor
SMS_PROVIDER=mellipayamak
SMS_FALLBACK_PROVIDER=kavenegar

MELLIPAYAMAK_USERNAME=
MELLIPAYAMAK_PASSWORD=
MELLIPAYAMAK_FROM=

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ─── درگاه پرداخت ───────────────────────────────────────
PAYMENT_GATEWAY=zibal
ZIBAL_MERCHANT=
ZARINPAL_MERCHANT_ID=

# ─── بی‌درنگ (فاز ۲) ────────────────────────────────────
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080

# ─── Web Push (بدون Firebase) ───────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@reshen.ir

# ─── نقشه (فاز ۴) ───────────────────────────────────────
NESHAN_API_KEY=

# ─── تنظیمات محصول (بازنویسی config/reshen.php) ─────────
RESHEN_PRIORITY_WINDOW=10
RESHEN_TURNOVER_BUFFER=5
