# ═══════════════════════════════════════════════════════════════════
# رشن — تنظیمات محیط
#
# این فایل نمونه است. نصاب (public/install.php) نسخهٔ واقعی `.env` را
# می‌سازد و APP_KEY را خودش تولید می‌کند.
#
# پس از نصب، برای هر تغییری همین `.env` را از File Manager ویرایش کنید.
# ═══════════════════════════════════════════════════════════════════

APP_NAME=رشن
APP_ENV=production
APP_DEBUG=false

# کلید امضای برنامه — نصاب می‌سازدش. دستی عوضش نکنید.
# همین حالا چیزی با آن امضا نمی‌شود؛ نگهش می‌داریم چون ساختنِ یک راز
# فقط سرِ نصب آسان است، و بعداً روی هاست اشتراکی ویرایش این فایل کار
# سختی است.
APP_KEY=

# آدرس کامل سایت، بدون اسلش آخر.
# اگر غلط باشد، لینک داخل QR و پیامک‌ها به جای اشتباه می‌برد.
APP_URL=https://example.com

APP_TIMEZONE=Asia/Tehran
SESSION_NAME=reshen_session

# ─── دیتابیس ───────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── پیامک ─────────────────────────────────────────────────────────
# log      = هیچ پیامکی نمی‌رود، فقط در storage/logs/sms.log نوشته
#            می‌شود. برای توسعه.
# melipayamak / kavenegar = واقعی
SMS_DRIVER=log

SMS_MELIPAYAMAK_USERNAME=
SMS_MELIPAYAMAK_PASSWORD=
SMS_MELIPAYAMAK_SENDER=

# کاوه‌نگار اگر پر شود، خودکار پشتیبان می‌شود
SMS_KAVENEGAR_API_KEY=

# ─── الگوهای پیامک ─────────────────────────────────────────────────
# روی خط خدماتی (۳۰۰۰، ۲۰۰۰، ۹۸۲۱) اپراتور پیامکِ متنِ آزاد را تحویل
# نمی‌دهد ولی «ارسال شد» می‌خورد و پول هم کم می‌شود.
#
# متن دقیق هر الگو در پنل → «الگوی پیامک» هست، آمادهٔ کپی کردن در پنل
# اپراتور. الگویی که شناسه نداشته باشد، فرستاده نمی‌شود.
SMS_PATTERN_MELIPAYAMAK_OTP=
SMS_PATTERN_MELIPAYAMAK_BOOKING_CONFIRMED=
SMS_PATTERN_MELIPAYAMAK_BOOKING_CANCELLED=
SMS_PATTERN_MELIPAYAMAK_SALON_NEW_BOOKING=
SMS_PATTERN_MELIPAYAMAK_REMINDER_24H=
SMS_PATTERN_MELIPAYAMAK_REMINDER_2H=
SMS_PATTERN_MELIPAYAMAK_QUEUE_CHAIR_READY=
SMS_PATTERN_MELIPAYAMAK_QUEUE_NEARLY_UP=
SMS_PATTERN_MELIPAYAMAK_QUEUE_DELAYED=

SMS_PATTERN_KAVENEGAR_OTP=
SMS_PATTERN_KAVENEGAR_BOOKING_CONFIRMED=
SMS_PATTERN_KAVENEGAR_BOOKING_CANCELLED=
SMS_PATTERN_KAVENEGAR_SALON_NEW_BOOKING=
SMS_PATTERN_KAVENEGAR_REMINDER_24H=
SMS_PATTERN_KAVENEGAR_REMINDER_2H=
SMS_PATTERN_KAVENEGAR_QUEUE_CHAIR_READY=
SMS_PATTERN_KAVENEGAR_QUEUE_NEARLY_UP=
SMS_PATTERN_KAVENEGAR_QUEUE_DELAYED=

# خط اختصاصی دارید؟ آن‌وقت متنِ آزاد هم تحویل می‌شود و الگوی جانیفتاده
# با متن کامل می‌رود. روی خط خدماتی این را روشن نکنید.
SMS_DEDICATED_LINE=false

# کیف پیامک فعلاً اعمال نمی‌شود — پلتفرم رایگان است.
SMS_ENFORCE_CREDIT=false

# ─── رزرو ──────────────────────────────────────────────────────────
# تأیید شمارهٔ مشتری با کد پیامکی.
#
# پیش‌فرض خاموش است و عمدی: هر گام اضافه بخشی از مشتری‌ها را می‌ریزد،
# و مشتری به دادهٔ حساسی دسترسی پیدا نمی‌کند. جای آن را محدودیت نرخ
# می‌گیرد.
#
# توجه: این فقط برای **مشتری** است. ورود کارکنان به پنل همیشه با کد
# پیامکی است (یا لینک یک‌بارمصرف: php tools/login-link.php 09xxxxxxxxx)
BOOKING_VERIFY_PHONE=false

# ─── پرداخت آنلاین ─────────────────────────────────────────────────
# disabled = خاموش (پیش‌فرض؛ پلتفرم رایگان است)
# zarinpal = روشن
PAYMENT_DRIVER=disabled
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ─── ظاهر ──────────────────────────────────────────────────────────
# vazirmatn (پیش‌فرض) یا iranyekan.
# برای ایران‌یکان، راهنمای public/assets/fonts/README.md را ببینید —
# فونت به‌دلیل لایسنس تجاری همراه پروژه توزیع نمی‌شود.
UI_FONT=vazirmatn
