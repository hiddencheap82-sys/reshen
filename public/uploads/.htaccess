# پوشهٔ آپلود — هیچ چیزی اینجا نباید اجرا شود.
#
# فایل‌ها پیش از ذخیره با GD بازرمزگذاری می‌شوند، پس نباید کد اجرایی
# داخلشان بماند. ولی این لایهٔ دوم لازم است: اگر روزی آن اعتبارسنجی
# دور زده شود، آپاچی باز هم فایل را اجرا نمی‌کند.

php_flag engine off

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|sh|asp|aspx)$">
  Require all denied
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# فقط تصویر سرو شود
<FilesMatch "\.(png|jpe?g|webp|svg)$">
  Header set Cache-Control "public, max-age=2592000"
  Header set X-Content-Type-Options "nosniff"
</FilesMatch>

Options -Indexes -ExecCGI
AddHandler default-handler .php .phtml .php3 .php4 .php5 .php7 .phps
